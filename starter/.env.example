# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# In production, secrets come from files (SECRET_KEY_FILE=/run/secrets/secret_key), not from this file:
# see docs/secrets.md.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=unsafe-dev-secret-change-me
SITE_NAME=Starter

DATABASE_URL=postgres://starter:starter@db:5432/starter
CELERY_BROKER_URL=redis://redis:6379/0

# Postgres container (docker-compose.yml reads these too)
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter
